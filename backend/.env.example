# Copy to backend/.env and fill in. Never commit the filled-in file.

# Neon Postgres with the pgvector extension enabled.
DATABASE_URL=
# A separate database or Neon branch. Tests that need Postgres skip when this is unset.
TEST_DATABASE_URL=

# Google Drive service account. Paste the whole JSON key on one line.
# Leave empty to fall back to the local corpus mirror in corpus/out/.
GOOGLE_CREDENTIALS_JSON=
DRIVE_FOLDER_ID=

# OpenAI-compatible LLM. Defaults point at Groq.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
ROUTER_MODEL=llama-3.1-8b-instant

# Refusal threshold on the reranked top-1 score. Fitted on eval/questions_dev.csv only.
COVERAGE_TAU=0.5
